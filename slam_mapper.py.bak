#!/usr/bin/env python3
"""
Carte VL53 (carte A du double SLAM) — utilise la MEME odometrie VIO que RTAB-Map.

- Ecoute l'odometrie VIO : /odom (nav_msgs/Odometry, publiee par rgbd_odometry)
- Ecoute le nuage VL53   : /vl53l8/points (repere capteur, x-avant, ~64 points)
- Transforme les points VL53 dans le repere 'odom' via la pose VIO + montage camera,
  les accumule (filtre voxel) -> carte publiee sur /slam_map_vl53 (PointCloud2, 'odom').

Ainsi la carte VL53 (sparse) et la carte RTAB-Map (dense camera) partagent la
meme trajectoire -> comparaison directe des deux dans RViz.
"""
import math
import numpy as np

import rclpy
from rclpy.node import Node
from rclpy.qos import QoSProfile, ReliabilityPolicy, HistoryPolicy

from nav_msgs.msg import Odometry
from sensor_msgs.msg import PointCloud2
from sensor_msgs_py import point_cloud2 as pc2
from std_msgs.msg import Header
from visualization_msgs.msg import Marker


# montage du capteur sur le drone (base_link -> capteur), translation seule
# (le VL53, comme le corps, regarde vers l'avant +x -> pas de rotation)
CAM_OFFSET = np.array([0.12, 0.0, 0.24])


def quat_rotate(q, v):
    """Applique le quaternion q=(x,y,z,w) au vecteur v (numpy 3)."""
    x, y, z, w = q
    u = np.array([x, y, z])
    t = 2.0 * np.cross(u, v)
    return v + w * t + np.cross(u, t)


class SlamMapperVL53(Node):
    def __init__(self):
        super().__init__('slam_mapper_vl53')
        # best_effort : compatible avec les publishers capteurs (gz bridge) ET reliable
        sensor_qos = QoSProfile(reliability=ReliabilityPolicy.BEST_EFFORT,
                                history=HistoryPolicy.KEEP_LAST, depth=10)
        self.create_subscription(Odometry, '/odom', self.on_odom, sensor_qos)
        self.create_subscription(PointCloud2, '/vl53l8/points', self.on_cloud, sensor_qos)
        self.map_pub = self.create_publisher(PointCloud2, '/slam_map_vl53', 1)
        self.marker_pub = self.create_publisher(Marker, '/drone_marker', 1)

        self.have_odom = False
        self.pos = np.zeros(3)
        self.quat = np.array([0.0, 0.0, 0.0, 1.0])

        self.map_points = {}   # voxel -> (x,y,z)
        self.voxel = 0.10

        self.create_timer(1.0, self.publish_map)
        self.get_logger().info('Carte VL53 active : /odom + /vl53l8/points -> /slam_map_vl53')

    def on_odom(self, m: Odometry):
        p = m.pose.pose.position
        q = m.pose.pose.orientation
        self.pos = np.array([p.x, p.y, p.z])
        self.quat = np.array([q.x, q.y, q.z, q.w])
        self.have_odom = True
        self.publish_drone_marker(p, q)

    def publish_drone_marker(self, p, q):
        mk = Marker()
        mk.header.stamp = self.get_clock().now().to_msg()
        mk.header.frame_id = 'odom'
        mk.ns = 'drone'
        mk.id = 0
        mk.type = Marker.ARROW          # fleche = position + cap du drone
        mk.action = Marker.ADD
        mk.pose.position = p
        mk.pose.orientation = q
        mk.scale.x = 0.8                # longueur
        mk.scale.y = 0.15
        mk.scale.z = 0.15
        mk.color.r, mk.color.g, mk.color.b, mk.color.a = 0.1, 0.8, 1.0, 1.0
        self.marker_pub.publish(mk)

    def on_cloud(self, cloud: PointCloud2):
        if not self.have_odom:
            return
        pts = pc2.read_points(cloud, field_names=('x', 'y', 'z'), skip_nans=True)
        for p in pts:
            fx = float(p[0])
            if not math.isfinite(fx) or fx <= 0.0:
                continue
            v_cam = np.array([fx, float(p[1]), float(p[2])]) + CAM_OFFSET
            w = self.pos + quat_rotate(self.quat, v_cam)
            key = (round(w[0] / self.voxel), round(w[1] / self.voxel), round(w[2] / self.voxel))
            self.map_points[key] = (float(w[0]), float(w[1]), float(w[2]))

    def publish_map(self):
        if not self.map_points:
            return
        h = Header()
        h.stamp = self.get_clock().now().to_msg()
        h.frame_id = 'odom'
        self.map_pub.publish(pc2.create_cloud_xyz32(h, list(self.map_points.values())))


def main():
    rclpy.init()
    node = SlamMapperVL53()
    try:
        rclpy.spin(node)
    except (KeyboardInterrupt, rclpy.executors.ExternalShutdownException):
        pass
    finally:
        node.destroy_node()
        if rclpy.ok():
            rclpy.shutdown()


if __name__ == '__main__':
    main()
