Panels:
  - Class: rviz_common/Displays
    Name: Displays
Visualization Manager:
  Global Options:
    Fixed Frame: odom
    Frame Rate: 15
    Background Color: 0; 0; 0
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Plane Cell Count: 40
      Cell Size: 1
      Color: 100; 100; 100
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: true
      Show Names: true
      Marker Scale: 1.5
    - Class: rviz_default_plugins/PointCloud2
      Name: Carte A - ToF dense 2304
      Enabled: true
      Topic:
        Value: /slam_map_tof
        Reliability Policy: Best Effort
        History Policy: Keep Last
        Depth: 5
      Style: Boxes
      Size (m): 0.08
      Color Transformer: FlatColor
      Color: 255; 120; 0
    - Class: rviz_default_plugins/PointCloud2
      Name: Carte B - Camera RGB-D
      Enabled: true
      Topic:
        Value: /cloud_map
        Reliability Policy: Best Effort
        History Policy: Keep Last
        Depth: 5
      Style: Points
      Size (Pixels): 2
      Color Transformer: RGB8
    - Class: rviz_default_plugins/Marker
      Name: Drone
      Enabled: true
      Topic:
        Value: /drone_marker
        Reliability Policy: Best Effort
        History Policy: Keep Last
        Depth: 5
    - Class: rviz_default_plugins/Marker
      Name: VIO drift
      Enabled: true
      Topic:
        Value: /vio_marker
        Reliability Policy: Best Effort
        History Policy: Keep Last
        Depth: 5
    - Class: rviz_default_plugins/Marker
      Name: Truth drift
      Enabled: true
      Topic:
        Value: /truth_marker
        Reliability Policy: Best Effort
        History Policy: Keep Last
        Depth: 5
  Tools:
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/FocusCamera
    - Class: rviz_default_plugins/Measure
  Views:
    Current:
      Class: rviz_default_plugins/Orbit