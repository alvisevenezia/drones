Panels:
  - Class: rviz_common/Displays
    Name: Displays
Visualization Manager:
  Global Options:
    Fixed Frame: odom
    Frame Rate: 15
    Background Color: 0; 0; 0
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Plane Cell Count: 40
      Cell Size: 1
      Color: 100; 100; 100
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: true
      Show Names: true
      Marker Scale: 1.5
    - Class: rviz_default_plugins/Map
      Name: Grille 2D exploration
      Enabled: true
      Topic:
        Value: /explore/grid
        Reliability Policy: Reliable
        History Policy: Keep Last
        Depth: 5
      Color Scheme: map
      Alpha: 0.7
    - Class: rviz_default_plugins/Marker
      Name: Frontieres (jaune)
      Enabled: true
      Topic:
        Value: /explore/frontiers
        Reliability Policy: Reliable
        History Policy: Keep Last
        Depth: 5
    - Class: rviz_default_plugins/Marker
      Name: But exploration (magenta)
      Enabled: true
      Topic:
        Value: /explore/goal_marker
        Reliability Policy: Reliable
        History Policy: Keep Last
        Depth: 5
    - Class: rviz_default_plugins/Marker
      Name: Drone VIO (bleu)
      Enabled: true
      Topic:
        Value: /vio_marker
        Reliability Policy: Best Effort
        History Policy: Keep Last
        Depth: 5
    - Class: rviz_default_plugins/Marker
      Name: Verite PX4 (rouge)
      Enabled: true
      Topic:
        Value: /truth_marker
        Reliability Policy: Best Effort
        History Policy: Keep Last
        Depth: 5
  Tools:
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/FocusCamera
    - Class: rviz_default_plugins/Measure
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Name: Current View
      Distance: 20
      Pitch: 0.7
      Yaw: 0.8
      Focal Point:
        X: 0
        Y: 0
        Z: 0
