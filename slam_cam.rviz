Panels:
  - Class: rviz_common/Displays
    Name: Displays
Visualization Manager:
  Global Options:
    Fixed Frame: odom
    Frame Rate: 15
    Background Color: 0; 0; 0
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Plane Cell Count: 40
      Cell Size: 1
      Color: 100; 100; 100
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: true
      Marker Scale: 1.5
    - Class: rviz_default_plugins/Marker
      Name: Drone
      Enabled: true
      Topic:
        Value: /drone_marker
        Reliability Policy: Best Effort
        History Policy: Keep Last
        Depth: 5
    - Class: rviz_default_plugins/PointCloud2
      Name: Carte B - Camera RGB-D (dense)
      Enabled: true
      Topic:
        Value: /cloud_map
        Reliability Policy: Best Effort
        History Policy: Keep Last
        Depth: 5
      Style: Points
      Size (Pixels): 2
      Color Transformer: RGB8
  Tools:
    - Class: rviz_default_plugins/MoveCamera
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 20
      Pitch: 0.7
      Yaw: 0.8
      Focal Point:
        X: 0
        Y: 0
        Z: 0
Window Geometry:
  Height: 450
  Width: 1500
